{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memo-map",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memomap-db",
      "database_id": "bc973c55-24f5-4ba3-bcab-1458ef3a7700",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "memomap-media"
    }
  ]
}
